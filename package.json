{
  "name": "open-download",
  "version": "1.1.2",
  "description": "Chrome 扩展 — 全局监听网络请求，自动识别并批量下载图片和视频",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js && echo '在 Chrome 中加载 dist 目录: chrome://extensions'",
    "pack": "node scripts/pack.js",
    "test": "node --experimental-vm-modules --experimental-specifier-resolution=node node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --experimental-specifier-resolution=node node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules --experimental-specifier-resolution=node node_modules/jest/bin/jest.js --coverage"
  },
  "keywords": ["chrome-extension", "image-downloader", "webrequest", "batch-download"],
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": ["./jest.setup.js"],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/lib/**/*.js",
      "!**/node_modules/**"
    ],
    "verbose": true,
    "transform": {},
    "moduleFileExtensions": ["js"],
    "testPathIgnorePatterns": ["node_modules"]
  }
}
